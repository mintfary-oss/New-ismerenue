# AQI Platform — переменные окружения
# Скопируйте этот файл в .env и заполните значения:
#   cp .env.example .env && nano .env

# ── Обязательные параметры ─────────────────────────────────────────────────

# Секрет для подписи JWT токенов (минимум 32 символа)
# Генерация: openssl rand -base64 48 | tr -d /=+
JWT_SECRET=ЗАМЕНИТЕ_НА_СЛУЧАЙНУЮ_СТРОКУ_МИНИМУМ_32_СИМВОЛА

# Пароль базы данных PostgreSQL
# Генерация: openssl rand -base64 32 | tr -d /=+
DB_PASSWORD=ЗАМЕНИТЕ_НА_НАДЁЖНЫЙ_ПАРОЛЬ

# Пароль Redis
# Генерация: openssl rand -base64 24 | tr -d /=+
REDIS_PASSWORD=ЗАМЕНИТЕ_НА_НАДЁЖНЫЙ_ПАРОЛЬ

# ── Параметры сервера ──────────────────────────────────────────────────────

# Внешний URL платформы (без слеша в конце)
BASE_URL=https://your-domain.ru

# Порты Nginx
HTTP_PORT=80
HTTPS_PORT=443

# Версия образа
APP_VERSION=latest

# ── Email (опционально — для приёма данных по почте) ──────────────────────

# IMAP сервер для приёма данных с адреса Ecology@kemerovo.ru
IMAP_HOST=imap.kemerovo.ru
IMAP_USER=Ecology@kemerovo.ru
IMAP_PASSWORD=

# SMTP для отправки уведомлений
SMTP_HOST=smtp.kemerovo.ru
SMTP_USER=
SMTP_PASSWORD=
FROM_ADDR=noreply@kemerovo.ru
